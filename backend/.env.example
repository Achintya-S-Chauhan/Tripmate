# TripMate Backend Environment Configuration
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/tripmate?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=tripmate_development_secret_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Optional custom DNS resolver (resolves Node.js c-ares SRV ECONNREFUSED with MongoDB Atlas on Windows)
DNS_SERVERS=8.8.8.8,8.8.4.4

